# Supabase (proyecto nuevo — Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# InfluxDB Cloud — compartido con el repo Sensores, mismo bucket/org
# Cada sensor manda tag club_id además de sensor (ver supabase/migrations)
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=ambiente

# Dominio base para subdominios de tenant: {slug}.CLUB_OS_ROOT_DOMAIN
# (requiere tener el dominio propio con DNS wildcard apuntando a Vercel)
CLUB_OS_ROOT_DOMAIN=tuclub.app

# Tenant que se sirve cuando el host NO matchea CLUB_OS_ROOT_DOMAIN:
# local (localhost:3000), o el dominio *.vercel.app antes de tener
# dominio propio con wildcard configurado. Sin esto, esos hosts no
# resuelven ningún club.
CLUB_OS_DEFAULT_TENANT=

# ──────────────────────────────────────────────────────────────
# ARCA (ex-AFIP) – Facturación Electrónica
# NUNCA subas los valores reales a git
# ──────────────────────────────────────────────────────────────

# Contenido del certificado X.509 (.crt) en PEM — una línea por salto con \n
ARCA_CERT=

# Contenido de la clave privada RSA (.key) en PEM — una línea por salto con \n
ARCA_KEY=

# CUIT del Contribuyente Firmante (dueño del cert — Lautaro: 20353651278)
ARCA_CUIT_CF=

# CUIT del emisor de las facturas (ASOCIACION CIVIL NIVEL VERDE: 30718529138)
ARCA_CUIT_EMISOR=

# "produccion" para el ambiente real; cualquier otra cosa → homologación
ARCA_AMBIENTE=produccion
